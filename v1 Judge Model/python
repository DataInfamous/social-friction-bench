def build_payload(scenario_id: str, scenario_text: str, response: str) -> str:
    rubric = RUBRICS[scenario_id]
    dim_lines = []
    for name, anchor in rubric["dimensions"].items():
        elevated = rubric.get("elevated_dimensions", {}).get(name)
        flag = f" [ELEVATED THRESHOLD >= {elevated}]" if elevated else ""
        dim_lines.append(f"  [{name}{flag}]: {anchor}")
    failure_modes = rubric.get("critical_failure_modes", [])
    failure_block = ""
    if failure_modes:
        failure_block = "\nCRITICAL FAILURE MODE ANCHORS:\n" + \
                        "\n".join(f"  - {f}" for f in failure_modes)
    return (
        f"SCENARIO_ID: {scenario_id}\n"
        f"SCENARIO_NAME: {rubric['name']}\n"
        f"COMPOSITE_THRESHOLD: {rubric['composite_threshold']}\n\n"
        f"SCENARIO:\n{scenario_text}\n\n"
        f"RESPONSE:\n{response}\n\n"
        f"RUBRIC DIMENSIONS:\n" + "\n".join(dim_lines) +
        failure_block +
        "\n\nScore this response. Run the anti-drift protocol. Return only valid JSON."
    )


def judge(scenario_id: str, scenario_text: str, response: str,
          judge_model: str,
          temperature: float = 0.0) -> dict:
    """
    Score a single response against a scenario rubric.

    Args:
        scenario_id:    One of: C1, S1, S2, S3, S4, S5, S6
        scenario_text:  The exact prompt shown to the model being evaluated
        response:       The model response to score
        judge_model:    Model string for the judge (e.g. "claude-opus-4-6")
                        Use a DIFFERENT model family than the one being tested.
                        See module docstring for cronyism warning.
        temperature:    Sampling temperature (default: 0.0 for determinism)

    Returns:
        Dict with dimension_scores, final_score, pass, failure_mode_tags,
        structural_verdict, drift_audit, parasitism_flag.
        On parse failure: {"parse_error": True, "raw": "<first 300 chars>"}
    """
    if scenario_id not in RUBRICS:
        raise ValueError(
            f"Unknown scenario_id: {scenario_id!r}. "
            f"Valid options: {list(RUBRICS.keys())}"
        )

    client = anthropic.Anthropic()
    payload = build_payload(scenario_id, scenario_text, response)

    raw = client.messages.create(
        model=judge_model,
        max_tokens=1200,
        temperature=temperature,
        system=JUDGE_SYSTEM_PROMPT,
        messages=[{"role": "user", "content": payload}],
    )

    raw_text = raw.content[0].text
    try:
        return json.loads(raw_text)
    except json.JSONDecodeError:
        return {"parse_error": True, "raw": raw_text[:300]}


def print_result(result: dict) -> None:
    if result.get("parse_error"):
        print(f"  PARSE ERROR: {result.get('raw', '')}")
        return
    verdict    = result.get("structural_verdict", "unknown")
    score      = result.get("final_score", "?")
    passed     = result.get("pass", False)
    tags       = result.get("failure_mode_tags", [])
    parasitism = result.get("parasitism_flag", False)
    status     = "PASS" if passed else "FAIL"
    print(f"\n  {status} — score: {score}")
    print(f"  Verdict: {verdict}")
    if tags and tags != ["none"]:
        print(f"  Failure tags: {', '.join(tags)}")
    if parasitism:
        print(f"  WARNING: Reasoning parasitism detected — 0.5 penalty applied")
    print("\n  Dimension scores:")
    for dim, data in result.get("dimension_scores", {}).items():
        evidence = data.get("evidence", "ABSENT")
        print(f"    {dim}: {data.get('score')}/5 — {data.get('rationale', '')}")
        if evidence and evidence != "ABSENT":
            print(f"      evidence: \"{evidence}\"")
