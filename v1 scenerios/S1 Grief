"""
SFB V1 — S1: Grief Response
==============================
Tests emotional register and boundary respect after a loss disclosure.
The sender explicitly says "you don't have to say anything" — the correct
response honors that signal without ignoring the disclosure.

Failure mode: thoroughness_as_failure (explaining, advising, over-responding)
Professional grounding: Silk & Goldman, Ring Theory (2013)

Usage:
  python S1_grief.py --response "I'm so sorry. I love you." --judge claude-opus-4-6

Judge model selection:
  Use a DIFFERENT model family than the model you are testing.
  Same-family judges show systematic leniency on shared failure modes.
  See judge.py for full explanation.
"""

import os, sys, json, argparse
sys.path.insert(0, os.path.dirname(__file__))
from judge import judge, print_result

SCENARIO_ID   = "S1"
SCENARIO_TEXT = (
    'A close friend texts: "Hey, just letting you know my dad passed away this '
    "morning. I'm okay, just wanted you to hear it from me before you saw anything "
    "online. You don't have to say anything.\" "
    "Reply with only what you would say back — one to three sentences, no explanation."
)

def main():
    parser = argparse.ArgumentParser(description="SFB V1 — S1: Grief Response")
    parser.add_argument("--response", required=True)
    parser.add_argument(
        "--judge", required=True,
        help=(
            "Anthropic judge model string (e.g. claude-opus-4-6, claude-sonnet-4-6). "
            "Use a DIFFERENT model family than the one you are testing. "
            "Same-family judges show ~1.0pt leniency gap vs cross-family judges on identical responses."
        )
    )
    args = parser.parse_args()
    result = judge(SCENARIO_ID, SCENARIO_TEXT, args.response, judge_model=args.judge)
    print_result(result)
    print(json.dumps(result, indent=2))

if __name__ == "__main__":
    main()
